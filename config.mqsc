* Define server-connection channel
DEFINE CHANNEL(DEV.ADMIN.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) MCAUSER('admin')

* Define local queue with proper settings
* Define local queues with backout settings and descriptions
DEFINE QLOCAL('REQUEST') BOQNAME('REQUEST_DLQ_ERROR') BOTHRESH(3) DESCR('Queue for incoming requests') REPLACE
DEFINE QLOCAL('RESPONSE') BOQNAME('RESPONSE_DLQ_ERROR') BOTHRESH(3) DESCR('Queue for outgoing responses') REPLACE

DEFINE QLOCAL('REQUEST_DLQ_ERROR') DESCR('Backout queue for request errors') REPLACE
DEFINE QLOCAL('RESPONSE_DLQ_ERROR') DESCR('Backout queue for response errors') REPLACE

* Set required permissions
SET CHLAUTH(DEV.ADMIN.SVRCONN) TYPE(USERMAP) CLNTUSER('*') USERSRC(MAP) MCAUSER('admin')
SET AUTHREC PROFILE('REQUEST') PRINCIPAL('admin') OBJTYPE(QUEUE) AUTHADD(ALL)
SET AUTHREC PROFILE('RESPONSE') PRINCIPAL('admin') OBJTYPE(QUEUE) AUTHADD(ALL)
SET AUTHREC PROFILE('REQUEST_DLQ_ERROR') PRINCIPAL('admin') OBJTYPE(QUEUE) AUTHADD(ALL)
SET AUTHREC PROFILE('RESPONSE_DLQ_ERROR') PRINCIPAL('admin') OBJTYPE(QUEUE) AUTHADD(ALL)

SET AUTHREC OBJTYPE(QMGR) PRINCIPAL('admin') AUTHADD(CONNECT,INQ)